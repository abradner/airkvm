# Defaults applied on a fresh `idf.py build`. sdkconfig itself is gitignored:
# it is generated, machine-specific, and merge-hostile.
#
# Built, flashed, and booted against real ESP32-S3 hardware on 2026-08-31 —
# WiFi association/DHCP and the SSD1306 panel both confirmed. The HTTPS
# console itself is NOT yet confirmed serving (the boot log's "console at
# https://…" line comes from wifi.c on got-IP, not from esp_http_server —
# see issue #7 — and the console has not been reached from a client), nor is
# USB HID delivery to a target BIOS/OS (AGENTS.md §4, last rule).

CONFIG_IDF_TARGET="esp32s3"

# Two HID interfaces: a boot keyboard and a mouse, kept separate so the keyboard
# needs no report ID and BIOS boot protocol works (see main/usb_hid.c).
CONFIG_TINYUSB_HID_COUNT=2
CONFIG_TINYUSB_CDC_ENABLED=n
# Mass storage: a third interface, one removable-disk LUN, no medium until a
# source is attached (main/msc_out.c). Enabling this also compiles
# esp_tinyusb's tusb_msc_storage.c, which defines tud_mount_cb/tud_umount_cb
# and every tud_msc_* callback strongly, competing with main's. If Espressif's
# won the link, unplugging would no longer release held keys and nothing would
# say so — which is why main is linked WHOLE_ARCHIVE and
# tools/check_msc_symbols.cmake runs after every link. See the comment at
# those callbacks in main/hid_out_usb.c. This is an EXISTING symbol in any
# generated sdkconfig from before it flipped, and a defaults file cannot
# change an existing value (AGENTS.md §6.1): delete build/sdkconfig or edit
# it, then confirm in build/config/sdkconfig.h.
CONFIG_TINYUSB_MSC_ENABLED=y
# One TinyUSB callback per buffer-full of data. The default 512 means eight
# callbacks per 4 KB; this is one static DRAM buffer of this size. Tune after
# measuring (principle 6), not before.
CONFIG_TINYUSB_MSC_BUFSIZE=4096
# Setup mode's USB network device (main/usb_net.c): a CDC-NCM function on an
# NCM-only descriptor, never beside HID+MSC (the S3 has four IN endpoints).
# The class driver's NTB buffers are static and therefore paid for in every
# image, setup mode or not: one each way at Linux's 2048-byte minimum is
# 4 KB, against ~19 KB at esp_tinyusb's 3/3 × 3200 defaults, on a part
# whose free heap is the media cache's budget. Setup mode moves one form
# post; throughput is not a goal there. NET_MODE is an EXISTING choice
# symbol in any generated sdkconfig from before (AGENTS.md §6.1): edit it,
# then confirm CONFIG_TINYUSB_NET_MODE_NCM in build/config/sdkconfig.h.
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_NCM_OUT_NTB_BUFFS_COUNT=1
CONFIG_TINYUSB_NCM_IN_NTB_BUFFS_COUNT=1
CONFIG_TINYUSB_NCM_OUT_NTB_BUFF_MAX_SIZE=2048
CONFIG_TINYUSB_NCM_IN_NTB_BUFF_MAX_SIZE=2048

# The console holds one long-lived WebSocket plus three short static requests,
# and the media server (main/media_ws.c) is a second httpd instance with two
# client slots. Each instance also reserves three internal sockets, plus mDNS,
# which the old value of 10 did not leave room for. This is an EXISTING symbol
# in any generated sdkconfig from before: a defaults file cannot change it
# (AGENTS.md §6.1). Delete or edit your sdkconfig and confirm 16 in
# build/config/sdkconfig.h, or the failure is a runtime accept()/socket()
# ENFILE on whichever of TLS accept and mDNS loses.
CONFIG_LWIP_MAX_SOCKETS=16
# IDF's DHCP server puts ITS OWN address into the DNS option of every offer
# whenever a netif's DNS flag is off — the "off" branch is where the default
# goes in, not where nothing goes in (dhcpserver.c, add_offer_options). With
# it on, setup mode's USB link (main/usb_net.c) would hand the plugged-in
# machine a resolver that answers nothing, which is "resolver touched" in
# R-009's terms and the opposite of what that link promises. Off, the DNS
# option means what the flag says; the softAP link then names its captive
# resolver explicitly (main/setup_mode.c). EXISTING symbol (AGENTS.md §6.1):
# edit every generated sdkconfig by hand and confirm the header has no
# CONFIG_LWIP_DHCPS_ADD_DNS line; CI checks that.
CONFIG_LWIP_DHCPS_ADD_DNS=n
CONFIG_HTTPD_WS_SUPPORT=y
# IDF's default, pinned because main/media_proto.h sizes a media piece to fit
# one inbound record payload (MEDIA_DATA_MAX). If this changes, that must too.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384

# --- Flash & partitions ---
# Flash size was ESP-IDF's 2MB default until measured against real hardware
# with `esptool flash_id` on 2026-08-31: this part is 4MB (XMC), plus 2MB of
# PSRAM the current design does not use. Wrong-but-unmeasured 2MB flash size
# is what the earlier dual-OTA sizing contingency in docs/design/fleet.md was
# hedging against; that hedge no longer applies. Confirm again if the board
# revision changes — this is a measurement, not a part-family guarantee.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Two OTA app slots, no factory partition (esp_https_ota boots directly into
# ota_0 on first flash). This is what makes OTA delivery possible at all —
# SINGLE_APP_LARGE, the previous choice, has exactly one app slot, so there is
# nowhere to write a new image while the running one keeps serving. The stock
# "_large" variant is used rather than a hand-rolled CSV: 1700K per slot
# against a measured image of 0xfe820 bytes (~1019K, TLS on, per this
# commit's build via ESP-IDF's own check_sizes.py) leaves ~40% headroom
# without this file carrying offset arithmetic someone has to re-verify by
# hand. The console's HTML/JS/CSS embedded in the binary is what pushed the
# image past the original 1MB single-app default in the first place.
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y

# Without this, a freshly-OTA'd image boots straight to VALID with no chance
# to prove itself — a bad update that boots but is otherwise broken just keeps
# running instead of reverting. With it, a new image boots PENDING_VERIFY and
# the bootloader reverts to the previous slot on the *next* reset unless
# something calls esp_ota_mark_app_valid_cancel_rollback() first after
# confirming the boot healthy. (main/ota.c does this today, gated on WiFi
# association — a real fleet build should confirm more than that before
# calling a boot healthy.)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# --- TLS ---
# mbedTLS allocates its session buffers on demand rather than holding a fixed
# ~32KB per connection for the lifetime of the server. On a part with ~190KB of
# usable heap that is the difference between HTTPS working and the console
# failing to accept a second connection.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# The console is the only TLS peer; dropping the obsolete suites saves flash
# and removes downgrade surface. TLS 1.3 is deliberately NOT enabled here — see
# the CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n stanza below and issue #24. This file
# used to set it =y at this line, which a later =n silently overrode; two
# contradicting assignments in one defaults file left a crash-inducing option
# disabled only by ordering.

# 1kHz scheduler ticks, not ESP-IDF's default 100Hz.
#
# This device's entire job is low-latency input, and a 10ms scheduling quantum
# is too coarse for a 10ms USB endpoint interval: the report task and the
# endpoint alias against each other, so a task that wakes every 10ms catches
# the endpoint's ready window only every other time and typing throughput
# halves. Measured on hardware — at 100Hz a 60-character string sent at
# 10ms/char delivered 26 of 60; at 1kHz it delivers all 60.
#
# The cost is ~1000 timer interrupts/second/core instead of 100, on the order
# of 0.1-0.2% CPU. That is bought back many times over by the report task no
# longer spinning (see REPORT_TICK_MS in main/hid_out_usb.c), which is what
# made this granularity necessary to state explicitly rather than inherit.
CONFIG_FREERTOS_HZ=1000

# TLS 1.2 only. ESP-IDF enables mbedTLS's TLS 1.3 by default, and its *server*
# path crashes this firmware: every handshake took a NULL dereference
# (LoadProhibited, EXCVADDR 0x00000000) inside ssl_parse_record_header, reached
# from ssl_tls13_process_client_hello with ssl->conf NULL, and rebooted the
# board. The server entered the 1.3 state machine even when the client offered
# only TLS 1.2, so it was not avoidable from the client side.
#
# That was issue #24 — the console was unreachable on real hardware for days
# and presented as "accepts TCP on 443, answers nothing, resets", which looks
# like a certificate or resource problem and is neither.
#
# We do not need 1.3: the console is a LAN page served to a browser that has
# imported our CA. Turning it off fixes the crash, and drops ~55KB of image.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n
