# Defaults applied on a fresh `idf.py build`. sdkconfig itself is gitignored:
# it is generated, machine-specific, and merge-hostile.
#
# Built, flashed, and booted against real ESP32-S3 hardware on 2026-08-31 —
# WiFi association/DHCP and the SSD1306 panel both confirmed. The HTTPS
# console itself is NOT yet confirmed serving (the boot log's "console at
# https://…" line comes from wifi.c on got-IP, not from esp_http_server —
# see issue #7 — and the console has not been reached from a client), nor is
# USB HID delivery to a target BIOS/OS (AGENTS.md §4, last rule).

CONFIG_IDF_TARGET="esp32s3"

# Two HID interfaces: a boot keyboard and a mouse, kept separate so the keyboard
# needs no report ID and BIOS boot protocol works (see main/usb_hid.c).
CONFIG_TINYUSB_HID_COUNT=2
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_MSC_ENABLED=n

# The console holds one long-lived WebSocket plus three short static requests;
# the default of 7 open sockets leaves room for a second browser to connect and
# be told it is not in control.
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_HTTPD_WS_SUPPORT=y

# --- Flash & partitions ---
# Flash size was ESP-IDF's 2MB default until measured against real hardware
# with `esptool flash_id` on 2026-08-31: this part is 4MB (XMC), plus 2MB of
# PSRAM the current design does not use. Wrong-but-unmeasured 2MB flash size
# is what the earlier dual-OTA sizing contingency in docs/design/fleet.md was
# hedging against; that hedge no longer applies. Confirm again if the board
# revision changes — this is a measurement, not a part-family guarantee.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Two OTA app slots, no factory partition (esp_https_ota boots directly into
# ota_0 on first flash). This is what makes OTA delivery possible at all —
# SINGLE_APP_LARGE, the previous choice, has exactly one app slot, so there is
# nowhere to write a new image while the running one keeps serving. The stock
# "_large" variant is used rather than a hand-rolled CSV: 1700K per slot
# against a measured image of 0xfe820 bytes (~1019K, TLS on, per this
# commit's build via ESP-IDF's own check_sizes.py) leaves ~40% headroom
# without this file carrying offset arithmetic someone has to re-verify by
# hand. The console's HTML/JS/CSS embedded in the binary is what pushed the
# image past the original 1MB single-app default in the first place.
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y

# Without this, a freshly-OTA'd image boots straight to VALID with no chance
# to prove itself — a bad update that boots but is otherwise broken just keeps
# running instead of reverting. With it, a new image boots PENDING_VERIFY and
# the bootloader reverts to the previous slot on the *next* reset unless
# something calls esp_ota_mark_app_valid_cancel_rollback() first after
# confirming the boot healthy. (main/ota.c does this today, gated on WiFi
# association — a real fleet build should confirm more than that before
# calling a boot healthy.)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# --- TLS ---
# mbedTLS allocates its session buffers on demand rather than holding a fixed
# ~32KB per connection for the lifetime of the server. On a part with ~190KB of
# usable heap that is the difference between HTTPS working and the console
# failing to accept a second connection.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# The console is the only TLS peer and it speaks TLS 1.2/1.3; dropping the
# obsolete suites saves flash and removes downgrade surface.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y

# 1kHz scheduler ticks, not ESP-IDF's default 100Hz.
#
# This device's entire job is low-latency input, and a 10ms scheduling quantum
# is too coarse for a 10ms USB endpoint interval: the report task and the
# endpoint alias against each other, so a task that wakes every 10ms catches
# the endpoint's ready window only every other time and typing throughput
# halves. Measured on hardware — at 100Hz a 60-character string sent at
# 10ms/char delivered 26 of 60; at 1kHz it delivers all 60.
#
# The cost is ~1000 timer interrupts/second/core instead of 100, on the order
# of 0.1-0.2% CPU. That is bought back many times over by the report task no
# longer spinning (see REPORT_TICK_MS in main/hid_out_usb.c), which is what
# made this granularity necessary to state explicitly rather than inherit.
CONFIG_FREERTOS_HZ=1000
