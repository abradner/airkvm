<h1>Set up this coordinator</h1>
<p>
  This creates the account for this installation and its first operator.
  It is available only until an account exists.
</p>

<% if @errors.present? %>
  <ul role="alert">
    <% @errors.each do |message| %><li><%= message %></li><% end %>
  </ul>
<% end %>

<%= form_with scope: :setup, url: setup_path do |form| %>
  <p><%= form.label :account_name, "Account name" %><br>
     <%= form.text_field :account_name, required: true, autofocus: true %></p>
  <p><%= form.label :email_address, "Your email" %><br>
     <%= form.email_field :email_address, required: true, autocomplete: "username" %></p>
  <p><%= form.label :password %> (at least 12 characters)<br>
     <%= form.password_field :password, required: true, minlength: 12, autocomplete: "new-password" %></p>
  <p><%= form.label :password_confirmation, "Confirm password" %><br>
     <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %></p>
  <p><%= form.submit "Create account" %></p>
<% end %>
