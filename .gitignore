# --- Universal ---
.DS_Store
Thumbs.db
*.log
*.swp
*.swo

# `tmp/` used to live in the universal block and had to leave it, because a
# directory-form exclusion cannot be negated from underneath: Rails tracks
# .keep files inside otherwise-ignored directories, and `tmp/` made
# `!/coordinator/tmp/.keep` unreachable no matter where it was written — a
# child .gitignore cannot rescue it either. Measured, not assumed:
# `git check-ignore --no-index coordinator/tmp/.keep` reported it ignored.
#
# So tmp is now ignored per tree. Any future tree with a tmp/ adds its own
# line here rather than inheriting one — the same deliberate-not-inherited
# rule the sdkconfig re-allows below follow.
/tmp/

# Local agent config (per-machine permissions — never shared)
.claude/settings.local.json
# Session handoffs (.claude/skills/park-context) are local, ephemeral state: one
# session's un-recoverable context, written to be read once by the next session
# and deleted when the work lands. Committing them would publish a snapshot that
# is stale on arrival and, worse, would let a broad `git add -A` during a resumed
# session push someone else's half-finished thinking. resume-context states they
# are gitignored; this is the line that makes that true.
.claude/handoffs/

# Env files — commit templates (.env.template*), never real values
.env
.env.*
!.env.template
!.env.template.*

# IDE local state (uncomment if unwanted in this repo)
# .idea/
# .vscode/

# --- ESP-IDF / CMake (firmware/) ---
# Unanchored on purpose: build dirs appear under firmware/ and under
# firmware/tools/{led_scan,i2c_scan}/, which are their own IDF projects.
build/
build-*/
managed_components/

# Generated sdkconfigs hold real WiFi credentials — ignore every variant, then
# re-allow only the checked-in templates. Listing files individually let
# `sdkconfig.bench.generated` through once; a deny-all-then-allow rule cannot
# make that mistake again as new targets are added.
#
# The re-allows are anchored to the directories that actually hold checked-in
# sdkconfigs. Unanchored, `!sdkconfig.defaults` would re-allow one dropped in
# any future tree, which is a promise this repo has no reason to make.
#
# Note there are FIVE checked-in sdkconfigs, not three: tools/i2c_scan and
# tools/led_scan are their own little IDF projects and each ships one. Anchoring
# only the firmware/ three silently moved those two into the ignored set — they
# stayed tracked, so nothing broke, and `git check-ignore` on a tracked file
# reports "not ignored" and hides it. `git check-ignore --no-index` is what
# shows the truth; use it when touching these lines.
#
# Enumerated, not globbed. `!/firmware/tools/*/sdkconfig.defaults` would work
# today and would also re-allow the file for every tool directory added later —
# which is the deny-all-then-re-allow rule above defeating itself, since the
# whole point is that a new target must be added deliberately rather than
# inherited. Adding a sixth means adding a line here, on purpose.
sdkconfig*
!/firmware/sdkconfig.defaults
!/firmware/sdkconfig.bench
!/firmware/sdkconfig.lcd147
!/firmware/tools/i2c_scan/sdkconfig.defaults
!/firmware/tools/led_scan/sdkconfig.defaults
dependencies.lock
*.bin
*.elf
*.map

# ESP-IDF checkout and its downloaded toolchains (installed by `mise run fw:setup`,
# pinned in mise.toml — several GB, never committed)
.esp-idf/
.esp-idf-tools/

# --- Python (firmware/tools/) ---
__pycache__/
*.pyc
.venv/
.ruff_cache/

# --- TLS material ---
# Device keys and the local CA private key. The CA key can mint a certificate
# for any name the trusting machines accept, so it is treated like an ssh key.
# Unanchored: firmware/tools/make_certs.sh writes firmware/certs/, and a
# coordinator holding key material must be covered by the same rule.
certs/

# --- coordinator/ (Rails) ---
# Path-scoped rather than a nested .gitignore: the negations below have to
# out-rank the universal block above, which only works from this file.
/coordinator/.bundle
/coordinator/vendor/bundle
/coordinator/log/*
!/coordinator/log/.keep
/coordinator/tmp/*
!/coordinator/tmp/.keep
/coordinator/tmp/pids/*
!/coordinator/tmp/pids/
!/coordinator/tmp/pids/.keep
/coordinator/public/assets
# Key material, and BOTH lines are needed. `rails new` generates
# config/master.key and, with --skip-git, no .gitignore to cover it. But a
# gitignore `*` never matches across a `/`, so `config/*.key` covers
# master.key and NOT config/credentials/production.key — which is where
# `bin/rails credentials:edit --environment production` writes the key that
# decrypts production secrets. coordinator/.dockerignore already listed that
# second path; this file had only the first.
#
# Found by review, verified with `git check-ignore --no-index` (the plain form
# reports a tracked file as not-ignored and hides exactly this class of gap).
/coordinator/config/*.key
/coordinator/config/credentials/**/*.key
/coordinator/app/assets/builds/*
!/coordinator/app/assets/builds/.keep
/coordinator/node_modules
