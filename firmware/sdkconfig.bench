# Bench overlay: ESP32-C3, no USB HID (see main/hid_out.h).
#
# The C3 cannot be a USB keyboard — its USB peripheral is a fixed-function
# serial/JTAG bridge. This image exists to exercise everything else on real
# hardware: WiFi, mDNS, the HTTP server, WebSocket framing, the decoder, the
# keymap, and the HID state machine. Applied on top of sdkconfig.defaults.

CONFIG_IDF_TARGET="esp32c3"

CONFIG_AIRKVM_HID_BACKEND_LOG=y

# The USB-Serial/JTAG peripheral is the console here, and it is also the only
# way to talk to the board — there is no separate UART bridge.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# sdkconfig.defaults asks for two TinyUSB HID interfaces; TinyUSB is not built
# for this target at all, so those symbols simply do not exist here.

# sdkconfig.defaults' 4MB flash size and dual-OTA partition table were
# measured against the S3 dongle specifically (esptool flash_id, 2026-08-31)
# — not this board. Carrying an S3 measurement onto the C3 unverified is
# exactly the trap AGENTS.md §6.1 warns about, and the C3 doesn't need OTA
# slots anyway: it never ships, it exists to exercise everything except USB
# HID on real hardware (see the file header). Pinned back explicitly rather
# than silently inheriting.
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="2MB"
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
