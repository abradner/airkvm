{
  // Type-CHECKING only, never compiling. `tsc --noEmit` reads the .js files as
  // they ship; nothing here is built, bundled or transformed, and no
  // node_modules lands in this directory. The firmware embeds these exact
  // bytes (AGENTS.md §4), and `python3 -m http.server` here serves the same
  // ones, so the checker must never become a step between source and served.
  //
  // TypeScript 7 is the native compiler, so this costs well under a second.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Deliberately not `strict`. Turning it on buries the real findings under
    // hundreds of null checks against a DOM the page already knows is there —
    // every getElementById would need a guard for an element the HTML in this
    // same directory guarantees. The value here is catching contract drift
    // between the protocol tables, the session config and the input handlers,
    // and checkJs alone does that.
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["app.js"]
}
